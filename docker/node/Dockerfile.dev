FROM node:24-alpine

RUN apk add --no-cache bash chromium

RUN printf '#!/bin/sh\nexec /usr/bin/chromium --headless=new --no-sandbox --disable-gpu --disable-dev-shm-usage --disable-software-rasterizer "$@"\n' \
    > /usr/local/bin/chrome-no-sandbox \
    && chmod +x /usr/local/bin/chrome-no-sandbox

ENV CHROME_BIN=/usr/local/bin/chrome-no-sandbox

WORKDIR /app

RUN mkdir -p /app/node_modules && chown -R node:node /app

USER node

EXPOSE 4200

CMD ["sh", "-c", "npm install && npm start"]
